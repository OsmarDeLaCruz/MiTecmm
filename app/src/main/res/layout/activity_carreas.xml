<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="0dp"> <!-- ✅ Separamos los paddings para que no empuje tanto desde arriba -->

    <!-- HEADER (Menú Hamburguesa) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"> <!-- ✅ Reducido casi a cero para pegar el texto de MOD_02 -->

        <ImageView
            android:id="@+id/menuham"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#111111" /> <!-- Usé app:tint que es la práctica moderna -->
    </LinearLayout>

    <!-- TÍTULOS SUPER COMPACTOS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ MOD_02 · ACADEMIC_PROGRAMS ]"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="0dp"/> <!-- ✅ Pegado al título principal -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar Profesor"
        android:gravity="center"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="2dp"/> <!-- ✅ Pegado a la descripción -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profesores disponibles en el campus."
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="20dp"/> <!-- ✅ Único espacio grande para separar la búsqueda -->

    <!-- BARRA DE BÚSQUEDA -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="#6A1B9A"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#F5F5F5"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#6A1B9A"/>

            <EditText
                android:id="@+id/etBuscarCarrera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Busca por nombre o materia..."
                android:textSize="14sp"
                android:layout_marginStart="12dp"
                android:textColorHint="#888888"
                android:textColor="#111111"
                android:inputType="text"/>

            <TextView
                android:id="@+id/tvSinResultadosCarreras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No se encontraron carreras con ese nombre o siglas."
                android:textAlignment="center"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:padding="30dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- RECYCLER VIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCarreras"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp"/>

</LinearLayout>