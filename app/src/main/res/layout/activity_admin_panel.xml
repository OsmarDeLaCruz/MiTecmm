<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3F7"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/headerAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/menuham"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#111111" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de Control"
                android:layout_gravity="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 TecMM Campus Zapopan"
                android:layout_gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#666666"/>
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerAdmin"
        android:layout_marginBottom="28dp"
        android:scrollbars="none"
        android:fillViewport="true">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tabGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerAdmin"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_segmented_control"
            android:padding="4dp"
            app:checkedButton="@+id/tabCarreras"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabCarreras"
                style="@style/Widget.App.SegmentedButton.Left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARRERAS" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabProfesores"
                style="@style/Widget.App.SegmentedButton.Middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOCENTES" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabAvisos"
                style="@style/Widget.App.SegmentedButton.Middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVISOS" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabHorarios"
                style="@style/Widget.App.SegmentedButton.Right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORARIOS" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/scrollTabs"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAdminGeneric"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_admin_generic" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        app:backgroundTint="#0B0F1A"
        app:fabSize="normal"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="#FFFFFF" />

</RelativeLayout>