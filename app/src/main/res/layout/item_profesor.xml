<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER: Avatar y Datos de Identificación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar (Ahora Circular) -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F3E8FF">

                <TextView
                    android:id="@+id/tvAvatarProfesor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="AA"
                    android:textColor="#512DA8"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"/>
            </androidx.cardview.widget.CardView>

            <!-- Bloque de Texto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <!-- Nombre -->
                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Docente"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>

                <!-- Carrera -->
                <TextView
                    android:id="@+id/tvGrupo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingeniería en Sistemas Computacionales"
                    android:textColor="#4B5563"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <!-- Escuela / Sede -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 TecMM Campus Zapopan"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- LÍNEA DIVISORA SUTIL -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F4F6"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"/>

        <!-- BOTÓN CENTRADO (Diseño Outlined Elegante) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerHorario"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="VER HORARIO DEL DOCENTE"
            android:textColor="#512DA8"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:cornerRadius="12dp"
            app:strokeColor="#D1D5DB"
            app:strokeWidth="1.5dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconTint="#512DA8"
            app:iconGravity="textStart" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>